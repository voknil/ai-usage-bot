# Telegram bot token from @BotFather. The only required setting.
TELEGRAM_BOT_TOKEN='replace-with-botfather-token'

# Pin the bot to one chat (recommended). Without it, the first private chat
# that sends /start becomes the owner. Find your ID by sending /start once and
# reading `chat_id` in state/telegram-message.json.
# CHAT_ID='123456789'

# Where the bot keeps its small state files (default: ./state).
# STATE_DIR='state'

# How often to refresh, and how long a fetched value stays fresh.
# REFRESH_INTERVAL='1m'
# CACHE_TTL='4m'

# Usage levels (percent) that trigger a warning message.
# ALERT_THRESHOLDS='85,95'

# Claude Code: both are looked up automatically.
# CLAUDE_BIN='/Users/you/.local/bin/claude'
# CLAUDE_CREDENTIALS_FILE='/Users/you/.claude/.credentials.json'

# Codex subscription usage needs the CodexBar CLI (https://codexbar.app) on PATH.
# CODEXBAR_BIN='/opt/homebrew/bin/codexbar'

# OpenAI API spend for today. Needs an Admin API key (not a project key) with
# only the api.usage.read scope:
# platform.openai.com -> Settings -> Organization -> Admin keys
# OPENAI_ADMIN_KEY='sk-admin-...'

# LOG_LEVEL='info'     # debug | info | warn | error
# LOG_FORMAT='text'    # text | json
